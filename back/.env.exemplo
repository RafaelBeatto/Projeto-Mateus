# Variáveis locais do back — copie para .env e preencha.
# Lido pelo application.properties via spring.config.import.

# AWS S3
PROJETOS_S3_BUCKET=projetos-mamore
PROJETOS_S3_REGIAO=sa-east-1
PROJETOS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Login do dono do sistema (abre "Administração do sistema"). Ex.: administrador01
PROJETOS_DONO_LOGINS=
