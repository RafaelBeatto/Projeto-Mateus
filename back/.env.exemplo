# Variáveis locais do back — copie para .env e preencha.
# Lido pelo application.properties via spring.config.import.

# AWS S3
APAE_S3_BUCKET=apae-chorobura
APAE_S3_REGIAO=sa-east-1
APAE_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Login do dono do sistema (abre "Administração do sistema"). Ex.: admin
APAE_DONO_LOGINS=
