# Variáveis do back na AWS (perfil "aws"). NÃO versionar o arquivo preenchido.
# Em produção, prefira guardar os segredos no SSM Parameter Store (SecureString) ou no
# Secrets Manager e injetá-los na tarefa/instância, em vez de um arquivo.

SPRING_PROFILES_ACTIVE=aws

# Porta em que o back escuta (o Elastic Beanstalk define PORT sozinho; no ECS use 8080)
PORT=8080

# RDS PostgreSQL — sempre com sslmode=require (ou verify-full com o certificado da AWS)
PROJETOS_DB_URL=jdbc:postgresql://projetos-mamore.xxxxxxxx.sa-east-1.rds.amazonaws.com:5432/projetos_mamore?sslmode=require
PROJETOS_DB_USUARIO=postgres
# SEGREDO: a senha definida ao criar o RDS (este modelo é versionado: nunca preencha aqui)
PROJETOS_DB_SENHA=
PROJETOS_DB_POOL=10

# SEGREDO: gere com  openssl rand -hex 48  (mínimo 32 caracteres; trocar derruba todas as sessões)
PROJETOS_JWT_SEGREDO=

# OBRIGATÓRIO trocar pelo domínio real, mesmo com front e back no mesmo domínio: origem fora desta lista
# recebe 403, inclusive no login. Endereço(s) HTTPS, separados por vírgula, sem barra no final e sem curinga.
PROJETOS_CORS_ORIGENS=https://SEU-DOMINIO.com.br

# Login do dono do sistema: só ele abre a tela "Administração do sistema" (vazio = ninguém)
PROJETOS_DONO_LOGINS=administrador01

# S3 — na AWS deixe as chaves VAZIAS e dê ao papel IAM da instância/tarefa a política
# deploy/aws/politica-iam-s3.json. Só preencha se rodar fora da AWS.
PROJETOS_S3_BUCKET=projetos-mamore
PROJETOS_S3_REGIAO=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
